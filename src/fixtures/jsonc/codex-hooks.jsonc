{
  // ~/.codex/hooks.json
  "hooks": {
    "PreToolUse": [
      // block destructive shell commands
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "~/bin/guard.sh", "timeout": 10 }] },
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "~/bin/my-stop.sh", "timeout": 30 }] },
    ],
  },
}
